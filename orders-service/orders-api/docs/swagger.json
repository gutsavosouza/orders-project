{
    "swagger": "2.0",
    "info": {
        "title": "Orders API",
        "contact": {},
        "version": "0.1"
    },
    "basePath": "/",
    "paths": {
        "/orders": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "orders"
                ],
                "summary": "Create an order entry",
                "parameters": [
                    {
                        "description": "Order to be created",
                        "name": "order",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.OrderPlacedPayload"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/main.createOrderResponse"
                        }
                    },
                    "default": {
                        "description": "",
                        "schema": {
                            "$ref": "#/definitions/main.errorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.OrderItem": {
            "type": "object",
            "required": [
                "quantity",
                "sku",
                "unit_price"
            ],
            "properties": {
                "quantity": {
                    "type": "integer",
                    "example": 7
                },
                "sku": {
                    "type": "string",
                    "example": "SKU-1010"
                },
                "unit_price": {
                    "type": "number",
                    "example": 77.77
                }
            }
        },
        "main.OrderPlacedPayload": {
            "type": "object",
            "required": [
                "customer_id",
                "items",
                "order_id"
            ],
            "properties": {
                "customer_id": {
                    "type": "string",
                    "example": "9b2f6c1e-4a7d-4c3e-8f21-6d5a0b7e3c94"
                },
                "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/main.OrderItem"
                    }
                },
                "order_id": {
                    "type": "string",
                    "example": "51248c84-2fa0-40b7-a3fa-708b0035b7ea"
                }
            }
        },
        "main.createOrderResponse": {
            "type": "object",
            "properties": {
                "order_id": {
                    "type": "string",
                    "example": "3f1c2a9e-7b4d-4e8a-9c21-5d6f0a1b2c3d"
                }
            }
        },
        "main.errorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "order with that id already exists"
                }
            }
        }
    }
}